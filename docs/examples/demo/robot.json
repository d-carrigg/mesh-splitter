{
 "assets": "examples/robot",
 "model": "robot.stl",
 "out": null,
 "shots": "docs/examples/img",
 "viewport": {
  "width": 1000,
  "height": 900
 },
 "camera": {
  "az": 20,
  "el": 12,
  "dist": 0.95,
  "lift": 0
 },
 "css": "#__cursor, #status, #toolbar, #acts, #info, #rightCol { visibility: hidden !important }",
 "steps": [
  {
   "do": "load",
   "split": false
  },
  {
   "do": "eval",
   "js": "app.S.parts[0].color = '#b9bec7'; app.afterEdit(''); document.getElementById('status').textContent = ''"
  },
  {
   "do": "shot",
   "name": "robot-model",
   "clip": "#view"
  },
  {
   "do": "eval",
   "js": "localStorage.clear()"
  },
  {
   "do": "load"
  },
  {
   "do": "eval",
   "js": "document.getElementById('status').textContent = ''"
  },
  {
   "do": "shot",
   "name": "robot-auto",
   "clip": "#view"
  },
  {
   "do": "session",
   "file": "robot.split.json"
  },
  {
   "do": "eval",
   "js": "app.S.active = 0; app.refreshUI(); document.getElementById('status').textContent = ''"
  },
  {
   "do": "shot",
   "name": "robot-final",
   "clip": "#view"
  }
 ]
}