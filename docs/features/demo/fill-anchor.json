{
 "assets": "/mnt/project-files/mesh-splitter/demo-assets",
 "model": "curler.stl",
 "out": null,
 "viewport": {
  "width": 1200,
  "height": 800
 },
 "deviceScaleFactor": 1.5,
 "camera": {
  "az": -20,
  "el": 18,
  "dist": 1.0,
  "lift": 0.12
 },
 "css": "#__cursor { display: none !important } #status { visibility: hidden } #toolbar, .toolbar { visibility: hidden }",
 "steps": [
  {
   "do": "load"
  },
  {
   "do": "eval",
   "js": "document.getElementById('rightCol').style.visibility = 'hidden'; app.setFollow([5, 10, 2, 7], 3); const x = app.ensureXf(3); x.c = app.jointFrame(3).J.toArray(); x.r = [-40, 0, 40]; app.xfEdited(3); app.S.active = 0; app.afterEdit('')"
  },
  {
   "do": "eval",
   "js": "app.setAnchor([3, 7], false); app.fillMesh() && (app.fillMesh().visible = false); app.render()"
  },
  {
   "do": "shot",
   "name": "_front-before",
   "clip": [
    550,
    290,
    620,
    340
   ]
  },
  {
   "do": "eval",
   "js": "app.fillMesh() && (app.fillMesh().visible = true); app.render()"
  },
  {
   "do": "shot",
   "name": "_front-fill",
   "clip": [
    550,
    290,
    620,
    340
   ]
  },
  {
   "do": "eval",
   "js": "app.setAnchor([3, 7], true); app.S.active = 0; app.refreshUI()"
  },
  {
   "do": "shot",
   "name": "_front-anchor",
   "clip": [
    550,
    290,
    620,
    340
   ]
  },
  {
   "do": "camera",
   "az": -110,
   "el": 25,
   "s": 0,
   "dist": 0.85
  },
  {
   "do": "eval",
   "js": "app.setAnchor([3, 7], false); app.fillMesh() && (app.fillMesh().visible = false); app.render()"
  },
  {
   "do": "shot",
   "name": "_side-before",
   "clip": [
    430,
    320,
    500,
    450
   ]
  },
  {
   "do": "eval",
   "js": "app.fillMesh() && (app.fillMesh().visible = true); app.render()"
  },
  {
   "do": "shot",
   "name": "_side-fill",
   "clip": [
    430,
    320,
    500,
    450
   ]
  },
  {
   "do": "eval",
   "js": "app.setAnchor([3, 7], true); app.S.active = 0; app.refreshUI()"
  },
  {
   "do": "shot",
   "name": "_side-anchor",
   "clip": [
    430,
    320,
    500,
    450
   ]
  },
  {
   "do": "compare",
   "shots": [
    "_front-before",
    "_front-fill"
   ],
   "labels": [
    "Front arm turned up: holes where the hand and arm were",
    "Fill (default): the body is closed"
   ],
   "name": "gap-fill"
  },
  {
   "do": "compare",
   "shots": [
    "_side-before",
    "_side-fill",
    "_side-anchor"
   ],
   "labels": [
    "Before: the back arm's shoulder leaves a hole",
    "Fill: closed, but the arm floats off",
    "Anchor: new material keeps the arm joined"
   ],
   "name": "gap-anchor"
  },
  {
   "do": "eval",
   "js": "document.getElementById('rightCol').style.visibility = ''; app.S.active = 3; app.refreshUI(); app.setGizmo('rotate')"
  },
  {
   "do": "shot",
   "name": "gap-ui",
   "clip": "#xfCard"
  }
 ]
}